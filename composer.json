{
  "name": "msstc4symfony/logger-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Maxim Shamaev",
      "email": "maxim.shamaev@gmail.com"
    }
  ],
  "type": "symfony-bundle",
  "description": "Monolog extension",
  "keywords": [
    "php",
    "symfony",
    "monolog"
  ],
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Msstc4Symfony\\LoggerBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Msstc4Symfony\\LoggerBundle\\Test\\Unit\\": "tests/unit/"
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "composer-runtime-api": ">=2.2",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/security-bundle": "^6.4|^7.0|^8.0",
    "symfony/monolog-bundle": "^3.10|^4.0",
    "symfony/yaml": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.55",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-beberlei-assert": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=10.5",
    "roave/security-advisories": "dev-latest",
    "rector/rector": "^2.1",
    "sentry/sentry": "^4.0",
    "spaze/phpstan-disallowed-calls": "^v4.0"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^6.4|^7.0|^8.0"
    }
  }
}
